{
  "name": "content-compliance",
  "private": true,
  "type": "module",
  "description": "An example MCP App: fixed rules decide what must be right, AI suggests fixes, a person decides.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env --test server/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p panel",
    "start": "npm run build && node --env-file=.env server/main.ts",
    "build": "vite build",
    "dev": "concurrently --names panel,server \"vite\" \"PANEL_DEV_URL=http://localhost:5173 node --watch-path=server --watch-path=config --watch-path=content --env-file=.env server/main.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
